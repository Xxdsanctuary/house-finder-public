<!DOCTYPE html>
<html>

<head>
    <title>
        <%= room.title %>
    </title>
</head>

<body>
    <h1>
        <%= room.title %>
    </h1>
    <a href="/rooms">Back to All Rooms</a> |
    <a href="/rooms/<%= room._id %>/edit">Edit Room</a>

    <form action="/rooms/<%= room._id %>/delete" method="POST">
        <button type="submit" onclick="return confirm('Are you sure you want to delete this room?');">Delete
            Room</button>
    </form>
    <hr>

    <h2>Details</h2>
    <img src="/images/<%= room.image %>" alt="Room Image">

    <p><strong>Status:</strong>
        <%= room.availabilityStatus %>
    </p>
    <p><strong>Monthly Rent:</strong> $<%= room.monthlyRent %>
    </p>
    <p><strong>Region/MRT:</strong>
        <%= room.region %> - <%= room.nearestMRT %>
    </p>
    <p><strong>Description:</strong><br>
        <%= room.description %>
    </p>

    <h2>Amenities</h2>
    <ul>
        <li><strong>Toilet:</strong>
            <%= room.amenities && room.amenities.privateToilet ? "Private" : "Shared" %>
        </li>
        <li><strong>Air Conditioning:</strong>
            <%= room.amenities && room.amenities.aircon ? "Yes" : "No" %>
        </li>
        <li><strong>Wi-Fi:</strong>
            <%= room.amenities && room.amenities.wifi ? "Yes" : "No" %>
        </li>
        <li><strong>Furnishing:</strong>
            <%= room.amenities && room.amenities.fullyFurnished ? "Fully Furnished" : "Unfurnished" %>
        </li>
    </ul>

    <p><small>Raw ID: <%= room._id %></small></p>
    <p><small>Creator Fake ID: <%= room.creator %></small></p>
</body>

</html>