<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>New Comment - Roommate Finder</title>
</head>
<body>
    <%- include('../partials/nav') %>
    <h1>Add a Comment</h1>

    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form action="/listings/<%= listingId %>/comments" method="POST">
        <label>Comment</label><br>
        <textarea name="body" rows="4" cols="50" required></textarea><br><br>

        <button type="submit">Post Comment</button>
    </form>

    <br>
    <a href="/listings/<%= listingId %>/comments">Back to Comments</a>

</body>
</html>
